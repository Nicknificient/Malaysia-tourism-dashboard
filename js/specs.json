{
  "arrivals_bar_top6": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
      "url": "data/arrivals_top6.json"
    },
    "width": "container",
    "height": 310,
    "layer": [
      {
        "mark": {
          "type": "bar",
          "height": 22,
          "color": "#C9B27E",
          "opacity": 0.45,
          "cornerRadiusTopRight": 3,
          "cornerRadiusBottomRight": 3
        },
        "encoding": {
          "y": {
            "field": "Country",
            "type": "nominal",
            "sort": {
              "field": "rank",
              "order": "ascending"
            },
            "axis": {
              "labelFontSize": 11,
              "titleFontSize": 0,
              "labelLimit": 150
            }
          },
          "x": {
            "field": "Arrivals_2019",
            "type": "quantitative",
            "axis": {
              "format": ",.0f",
              "labelFontSize": 10,
              "title": "Arrivals",
              "titleFontSize": 11,
              "grid": true,
              "gridColor": "#EEE9E1"
            }
          }
        }
      },
      {
        "mark": {
          "type": "bar",
          "height": 12,
          "color": "#176B73",
          "cornerRadiusTopRight": 3,
          "cornerRadiusBottomRight": 3
        },
        "encoding": {
          "y": {
            "field": "Country",
            "type": "nominal",
            "sort": {
              "field": "rank",
              "order": "ascending"
            }
          },
          "x": {
            "field": "Arrivals_2025",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "rule",
          "color": "#D96B4C",
          "strokeWidth": 2.5,
          "size": 20
        },
        "encoding": {
          "y": {
            "field": "Country",
            "type": "nominal",
            "sort": {
              "field": "rank",
              "order": "ascending"
            }
          },
          "x": {
            "field": "Arrivals_2024",
            "type": "quantitative"
          }
        }
      }
    ],
    "encoding": {
      "tooltip": [
        {
          "field": "Country",
          "title": "Country"
        },
        {
          "field": "Arrivals_2025",
          "title": "Arrivals 2025",
          "format": ",.0f"
        },
        {
          "field": "Arrivals_2024",
          "title": "Arrivals 2024",
          "format": ",.0f"
        },
        {
          "field": "Arrivals_2019",
          "title": "Arrivals 2019 (benchmark)",
          "format": ",.0f"
        },
        {
          "field": "Growth_2025_vs_2019",
          "title": "Growth vs 2019 (%)",
          "format": ".1f"
        }
      ]
    },
    "config": {
      "font": "DM Sans",
      "background": "transparent",
      "view": {
        "stroke": "transparent"
      },
      "axis": {
        "labelColor": "#777",
        "domainColor": "#DDD6CC",
        "tickColor": "#DDD6CC"
      }
    }
  },
