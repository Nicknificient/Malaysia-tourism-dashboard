  "transport_bar": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Mode of Transport 2024",
    "data": {
      "url": "data/transport_mode.json"
    },
    "width": "container",
    "height": 240,
    "transform": [
      {
        "fold": [
          "y2024",
          "y2023",
          "y2019"
        ],
        "as": [
          "year_key",
          "arrivals"
        ]
      },
      {
        "calculate": "datum.year_key === 'y2024' ? '2024' : datum.year_key === 'y2023' ? '2023' : '2019'",
        "as": "Year"
      }
    ],
    "mark": {
      "type": "bar",
      "cornerRadiusTopLeft": 3,
      "cornerRadiusTopRight": 3
    },
    "encoding": {
      "x": {
        "field": "mode",
        "type": "nominal",
        "sort": [
          "-y2024"
        ],
        "axis": {
          "labelAngle": 0,
          "labelFontSize": 11,
          "titleFontSize": 0,
          "title": null
        }
      },
      "y": {
        "field": "arrivals",
        "type": "quantitative",
        "axis": {
          "format": ",.0f",
          "labelFontSize": 10,
          "title": "Arrivals",
          "titleFontSize": 11,
          "grid": true,
          "gridColor": "#EEE9E1"
        }
      },
      "xOffset": {
        "field": "Year",
        "type": "nominal"
      },
      "color": {
        "field": "Year",
        "type": "nominal",
        "scale": {
          "domain": [
            "2019",
            "2023",
            "2024"
          ],
          "range": [
            "#999999",
            "#0072B2",
            "#E69F00"
          ]
        },
        "legend": {
          "orient": "top",
          "labelFontSize": 11,
          "title": null
        }
      },
      "tooltip": [
        {
          "field": "mode",
          "title": "Mode"
        },
        {
          "field": "Year",
          "title": "Year"
        },
        {
          "field": "arrivals",
          "title": "Arrivals",
          "format": ",.0f"
        }
      ]
    },
    "config": {
      "font": "DM Sans",
      "background": "transparent",
      "view": {
        "stroke": "transparent"
      },
      "axis": {
        "labelColor": "#777",
        "domainColor": "#DDD6CC",
        "tickColor": "#DDD6CC"
      }
    }
  },
  "scatter_rooms_aor": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Hotel Rooms vs Occupancy Rate",
    "data": {
      "url": "data/state_merged.json"
    },
    "width": "container",
    "height": 280,
    "mark": {
      "type": "point",
      "filled": true,
      "color": "#176B73",
      "opacity": 0.8,
      "stroke": "white",
      "strokeWidth": 1.5
    },
    "encoding": {
      "x": {
        "field": "Rooms",
        "type": "quantitative",
        "axis": {
          "title": "Total Hotel Rooms",
          "labelFontSize": 10,
          "titleFontSize": 11,
          "grid": true,
          "gridColor": "#EEE9E1",
          "format": ",.0f"
        }
      },
      "y": {
        "field": "AOR_Jan_Dec",
        "type": "quantitative",
        "axis": {
          "title": "Average Occupancy Rate (%)",
          "labelFontSize": 10,
          "titleFontSize": 11,
          "grid": true,
          "gridColor": "#EEE9E1"
        }
      },
      "size": {
        "field": "Total_2025",
        "type": "quantitative",
        "scale": {
          "range": [
            60,
            600
          ]
        },
        "legend": {
          "title": "Total Guests 2025",
          "labelFontSize": 10,
          "titleFontSize": 10,
          "orient": "right",
          "gradientLength": 120
        }
      },
      "tooltip": [
        {
          "field": "State",
          "title": "State"
        },
        {
          "field": "Rooms",
          "title": "Rooms",
          "format": ",.0f"
        },
        {
          "field": "AOR_Jan_Dec",
          "title": "AOR (%)",
          "format": ".1f"
        },
        {
          "field": "Total_2025",
          "title": "Guests 2025",
          "format": ",.0f"
        },
        {
          "field": "foreign_pct",
          "title": "Foreign Guest %",
          "format": ".1f"
        }
      ]
    },
    "config": {
      "font": "DM Sans",
      "background": "transparent",
      "view": {
        "stroke": "transparent"
      },
      "axis": {
        "labelColor": "#777",
        "domainColor": "#DDD6CC",
        "tickColor": "#DDD6CC"
      }
    }
  },
  "stacked_guests": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Domestic vs Foreign Guests by State 2025",
    "data": {
      "url": "data/hotel_guests.json"
    },
    "width": "container",
    "height": 340,
    "transform": [
      {
        "fold": [
          "Domestic_2025",
          "Foreign_2025"
        ],
        "as": [
          "Guest_Type",
          "Count"
        ]
      },
      {
        "calculate": "datum.Guest_Type === 'Domestic_2025' ? 'Domestic' : 'Foreign'",
        "as": "Type"
      }
    ],
    "mark": {
      "type": "bar"
    },
    "encoding": {
      "y": {
        "field": "State",
        "type": "nominal",
        "sort": {
          "field": "Total_2025",
          "order": "descending"
        },
        "axis": {
          "labelFontSize": 11,
          "titleFontSize": 0
        }
      },
      "x": {
        "field": "Count",
        "type": "quantitative",
        "stack": "normalize",
        "axis": {
          "format": "%",
          "labelFontSize": 10,
          "title": "Share of Guests",
          "titleFontSize": 11,
          "grid": true,
          "gridColor": "#EEE9E1"
        }
      },
      "color": {
        "field": "Type",
        "type": "nominal",
        "scale": {
          "domain": [
            "Domestic",
            "Foreign"
          ],
          "range": [
            "#7A7A7A",
            "#66A182"
          ]
        },
        "legend": {
          "orient": "top",
          "labelFontSize": 11,
          "title": null
        }
      },
      "tooltip": [
        {
          "field": "State",
          "title": "State"
        },
        {
          "field": "Type",
          "title": "Guest Type"
        },
        {
          "field": "Count",
          "title": "Count",
          "format": ",.0f"
        }
      ]
    },
    "config": {
      "font": "DM Sans",
      "background": "transparent",
      "view": {
        "stroke": "transparent"
      },
      "axis": {
        "labelColor": "#777",
        "domainColor": "#DDD6CC",
        "tickColor": "#DDD6CC"
      }
    }
  },
  "choropleth": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Hotel Guests Choropleth Map \u2014 classified",
    "width": "container",
    "height": 260,
    "params": [
      {"name": "zoom_level",  "value": 1500},
      {"name": "centre_lon",  "value": 109.5},
      {"name": "centre_lat",  "value": 4.0}
    ],
    "projection": {
      "type": "mercator",
      "scale": {"expr": "zoom_level"},
      "center": {"expr": "[centre_lon, centre_lat]"}
    },
    "layer": [
      {
        "data": {
          "url": "data/malaysia_states.json",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "transform": [
          {
            "lookup": "properties.state",
            "from": {
              "data": {
                "url": "data/state_merged.json"
              },
              "key": "State",
              "fields": [
                "Total_2025",
                "AOR_Jan_Dec",
                "foreign_pct",
                "Hotels",
                "Rooms",
                "yoy_growth"
              ]
            }
          },
          {
            "calculate": "datum.Total_2025 < 1000000 ? '< 1M' : datum.Total_2025 < 5000000 ? '1M \u2013 4.9M' : datum.Total_2025 < 8000000 ? '5M \u2013 7.9M' : datum.Total_2025 < 14000000 ? '8M \u2013 13.9M' : '14M+'",
            "as": "GuestClass"
          }
        ],
        "mark": {
          "type": "geoshape",
          "stroke": "white",
          "strokeWidth": 1.2
        },
        "encoding": {
          "color": {
            "field": "GuestClass",
            "type": "ordinal",
            "scale": {
              "domain": [
                "< 1M",
                "1M \u2013 4.9M",
                "5M \u2013 7.9M",
                "8M \u2013 13.9M",
                "14M+"
              ],
              "range": [
                "#F9E0D4",
                "#E8A78A",
                "#D46B47",
                "#A83A1A",
                "#5E1A08"
              ]
            },
            "legend": {
              "title": "Total Hotel Guests 2025",
              "orient": "bottom",
              "direction": "horizontal",
              "columns": 3,
              "labelFontSize": 12,
              "titleFontSize": 12,
              "titleOrient": "top",
              "symbolSize": 140,
              "symbolType": "square",
              "columnPadding": 14,
              "rowPadding": 6,
              "padding": 6
            }
          },
          "tooltip": [
            {
              "field": "properties.state",
              "title": "State"
            },
            {
              "field": "Total_2025",
              "title": "Total Guests 2025",
              "format": ",.0f"
            },
            {
              "field": "GuestClass",
              "title": "Guest Range"
            },
            {
              "field": "AOR_Jan_Dec",
              "title": "Occupancy Rate (%)",
              "format": ".1f"
            },
            {
              "field": "foreign_pct",
              "title": "Foreign Guest %",
              "format": ".1f"
            },
            {
              "field": "Hotels",
              "title": "No. of Hotels"
            },
            {
              "field": "yoy_growth",
              "title": "YoY Growth (%)",
              "format": ".1f"
            }
          ]
        }
      }
    ],
    "config": {
      "font": "DM Sans",
      "background": "transparent",
      "view": {
        "stroke": "transparent"
      }
    }
  },
  "aor_heatmap": {
